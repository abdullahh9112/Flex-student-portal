<%- include('partials/head') %>
<div class="login-wrap">
  <div class="login-left">
    <div class="brand">Fle<span>x</span></div>
    <div class="tagline">Your student portal — courses, grades and campus life, all in one place.</div>
    <div class="dots">FAST NUCES · Student Information System</div>
  </div>

  <div class="login-right">
    <div class="login-card">
      <h2>Welcome back</h2>
      <div class="sub">Sign in to continue to your Flex dashboard.</div>

      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>
      <% if (info) { %>
        <div class="alert info"><%= info %></div>
      <% } %>

      <form action="/login" method="POST">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter your username" autofocus>

        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••">

        <button class="btn full" type="submit">Sign in</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
